# ===== Co-Sight Configuration (keep your existing values) =====
# ENVIRONMENT=development
# ENABLE_LANGFUSE=true
# LANGFUSE_HOST=https://us.cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=your-public-key
# LANGFUSE_SECRET_KEY=your-secret-key
# API_KEY=your-api-key
# API_BASE_URL=your-base-url
# MODEL_NAME=your-model
# MAX_TOKENS=4096
# TEMPERATURE=0.0

# ===== ReportBench Evaluation Requirements =====
# Add these to your existing .env file

# For ReportBench evaluation (LLM-based scoring)
OPENAI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# For citation verification (web scraping)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# For fact-checking (optional but recommended)
SERPAPI_API_KEY=your_serpapi_key_here

# General settings
TEMPERATURE=0.0
MAX_TOKENS=8192
